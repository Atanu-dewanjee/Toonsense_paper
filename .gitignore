# ---------------------------------------------------------------------------
# Datasets, caches and large intermediate artefacts (reproducible from scripts)
# ---------------------------------------------------------------------------
data/
features/
.cache/
*.zip

# Kaggle job packages (generated by scripts/09 and scripts/14) and their outputs
kaggle/
kaggle_output/

# Run logs
logs/

# ---------------------------------------------------------------------------
# Results: keep aggregate scores, tables and charts; drop per-meme artefacts
# that contain dataset text or meme images, and large prediction arrays.
# ---------------------------------------------------------------------------
results/**/*.npz
results/**/*.jpg
results/**/*_samples.csv
results/**/perturbed_texts.csv
results/**/manual_annotation_sheet.csv
results/**/gradcam_examples.png
results/**/token_ig_examples.*

# ---------------------------------------------------------------------------
# Paper build artefacts (PDFs are built from the LaTeX sources, not versioned)
# ---------------------------------------------------------------------------
paper/*.pdf
paper/ToonSense_*
paper/fall26/ToonSense_*
paper/figures/**/*.png
!paper/figures/cmban/gradcam_examples.png
paper/figures/methodology_flow_vertical.*

# Duplicate report outputs: PNG copies of the PDF figures, and LaTeX tables that
# are kept in paper/tables/
results/**/*.png
results/**/tables/*.tex
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls

# ---------------------------------------------------------------------------
# Python / tooling
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.env
.vscode/
.idea/
.claude/
Thumbs.db
.DS_Store

# Per-job checkpoint files of the augmentation step (merged into raw.csv)
results/**/augmentation/parts/
